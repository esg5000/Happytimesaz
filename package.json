{
  "name": "happytimesaz-sanity",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @happytimesaz/sanity run dev",
    "build": "pnpm --filter @happytimesaz/sanity run build",
    "deploy": "pnpm --filter @happytimesaz/sanity run deploy",
    "format": "pnpm --filter @happytimesaz/sanity run format",
    "sanity:dev": "npx pnpm@9.12.3 --filter @happytimesaz/sanity run dev",
    "sanity:build": "npx pnpm@9.12.3 --filter @happytimesaz/sanity run build",
    "sanity:deploy": "npx pnpm@9.12.3 --filter @happytimesaz/sanity run deploy"
  }
}
